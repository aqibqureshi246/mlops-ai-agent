FROM python:3.12.10-slim
COPY requirements/mlflow-lock.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt && pip check && python -c "from mlflow.store.tracking.sqlalchemy_store import SqlAlchemyStore"
RUN useradd --uid 10002 --create-home mlflow && mkdir -p /mlflow/artifacts && chown -R mlflow /mlflow
USER mlflow
WORKDIR /mlflow
EXPOSE 5000
CMD ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", "--backend-store-uri", "sqlite:////mlflow/mlflow.db", "--serve-artifacts", "--artifacts-destination", "/mlflow/artifacts", "--default-artifact-root", "mlflow-artifacts:/"]
