FROM apache/airflow:slim-3.0.1-python3.12
USER root
RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/* && git config --system --add safe.directory /opt/project
USER airflow
COPY requirements/airflow-lock.txt /tmp/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /tmp/requirements.txt && pip check
RUN python -c "from airflow.sdk import dag, task; import mlflow; import psycopg2; import asyncpg"
