# Local demonstration defaults. Never commit .env or credentials.
MLOPS_REPO_ROOT=.
MLOPS_MLFLOW_TRACKING_URI=http://localhost:5000
MLOPS_AIRFLOW_URL=http://localhost:8080
MLOPS_AIRFLOW_USERNAME=student
MLOPS_AIRFLOW_PASSWORD=
MLOPS_KUBE_NAMESPACE=mlops
MLOPS_KUBE_CONTEXT=mlops-agent-reader
MLOPS_KUBECONFIG=.runtime/kubeconfig-reader
# Set only when demonstrating an explicitly confirmed restart:
# MLOPS_KUBE_WRITE_CONFIG=.runtime/kubeconfig-operator
MLOPS_LLM_BASE_URL=http://localhost:11434/v1
MLOPS_LLM_API_KEY=ollama
MLOPS_LLM_MODEL=qwen2.5:3b
# Required for HTTP agent endpoints; generate with scripts/setup_local.py.
MLOPS_AGENT_API_KEY=
MLOPS_REQUEST_TIMEOUT=20
MLOPS_FRESHNESS_DAYS=30
